---
import '../styles/global.css';
import '../styles/celestial.css';
import Brand from '../components/Brand.astro';
import PersonSocials from '../components/PersonSocials.astro';
import heroSequence from '../../public/media/david-universe-4k/manifest.json';
import { site, team, supportingCast, experiments } from '../content/site';
---
<!doctype html>
<html lang="es">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="theme-color" content="#0b1d2c"/><title>{site.name} — {site.title}</title>
<meta name="description" content={site.description}/><meta property="og:title" content={`${site.name} — ${site.title}`}/><meta property="og:description" content={site.description}/><meta property="og:image" content={site.hero}/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="preload" href={site.hero} as="image"/>
<noscript><style>.celestial{height:100svh}.celestial .cosmic-stage{position:relative}</style></noscript>
</head>
<body>
<a class="skip-link" href="#episodio">Saltar al episodio</a>
<main>
<section class="celestial film-scroll" id="inicio" aria-label="El universo de Cuántica SL" data-start-frame="9" data-release-frame="80" data-end-frame="190" data-fps={heroSequence.fps}>
<span id="vision" class="vision-anchor" aria-hidden="true"></span>
<div class="film-stage cosmic-stage">
<img class="film-poster" src={site.hero} width="1920" height="1080" alt="David, CEO de Cuántica SL, asciende rodeado de los inventos de la empresa en un universo azul" fetchpriority="high"/>
<video id="hero-motion" class="hero-video" data-src="/media/hero-forward.mp4" muted playsinline preload="auto" disablepictureinpicture aria-hidden="true" tabindex="-1"></video>
<video id="hero-reverse" class="hero-video" data-src="/media/hero-reverse.mp4" muted playsinline preload="auto" disablepictureinpicture aria-hidden="true" tabindex="-1"></video>
<header class="header cosmic-header"><Brand/></header>
<h1 class="cosmic-statement"><span class="statement-left">Inventamos<br/>el futuro</span><span class="statement-right">Perdonad<br/>las molestias</span></h1>
</div>
</section>
<section class="manifesto section-wrap tv-shop" id="inventos">
<span class="section-mark mark-plus" aria-hidden="true">+</span>
<div class="tv-strip"><span>CUÁNTICA SHOP</span><span>★ ¡LOS INVENTOS DEL SIGLO! ★</span></div><div class="section-heading shop-heading"><img class="shop-peeking-bobby" src="/media/decor/bobby-retoque.png" alt="" aria-hidden="true" loading="lazy" decoding="async" /><h2>Soluciones <span class="shop-word-green">extraordinarias</span><br/>a problemas que no tenías.</h2><p>En Cuántica no nos preguntamos <em>"por qué"</em>. Nos preguntamos <em>"por cuánto"</em>.</p></div>
<div class="experiments">{experiments.map((item)=><article class="experiment"><div class="experiment-top"><span>{item.offer}</span><span class="mono">{item.code}</span></div><div class="product-photo"><img src={item.image} alt={item.alt} width="1024" height="1024" loading="lazy"/><span class="tv-seal">{item.seal}</span></div><h3>{item.name}</h3><p class="tv-promise">{item.promise}</p><div class="tv-price"><span>ANTES <s>{item.oldPrice}</s></span><strong>{item.price}<small>€*</small></strong></div><button class="button product-buy" type="button" data-play aria-label={`Comprar ${item.name}`} aria-haspopup="dialog">COMPRA YA <span aria-hidden="true">↗</span></button></article>)}</div><div class="tv-hype"><span class="tv-timer"><span><small>LA OFERTA CADUCA EN</small></span><b id="offer-countdown" role="timer" aria-live="off">42 días y 00:00:00 horas</b></span><strong>¡PERO ESPERA, HAY MÁS!</strong></div>
<div class="tv-guarantee"><strong>SI NO LO NECESITAS, ES CUÁNTICA.</strong><span>*Compra ficticia. Comedia de verdad.</span></div>
</section>
<section class="belief method-manifesto" aria-label="Nuestra forma de trabajar"><img class="method-peeking-cat" src="/media/decor/gato-curioso.png" alt="" aria-hidden="true" loading="lazy" decoding="async" />
<div class="method-heading"><span class="mono">EL ORDEN DE LOS FACTORES SÍ ALTERA EL PRODUCTO.</span></div>
<div class="method-composition"><p class="method-main">Primero cambiamos<br/>el mundo.</p><div class="method-note"><p>Luego leemos<br/>las instrucciones.</p></div></div>
<span class="section-mark mark-corner" aria-hidden="true"></span>
</section>
<section class="team section-wrap" id="equipo"><span class="section-mark mark-bracket" aria-hidden="true"></span><div class="team-divider" aria-hidden="true"></div><div class="section-heading"><h2>Seis formas de entender la ciencia.<br/><span class="serif-word">Ninguna para ponerse de acuerdo.</span></h2></div>
<div class="team-grid">{team.map((person,i)=><article class="person">
<svg class="person-frame" viewBox="0 0 400 600" preserveAspectRatio="none" aria-hidden="true"><path d="M8 13 L391 5 L394 589 L5 595 L8 13 M13 8 L397 12 L388 598"/></svg>
<div class="person-photo">{person.image && <><img src={`/media/team/linkedin/${person.image}-waist${person.image==='kike'?'-reference-shirt':person.image==='david'?'-neutral':person.image==='nati'?'-arms-down':''}.png`} alt={`${person.name}, ${person.role}`} width="600" height="800" loading="lazy"/><img class="person-photo-alternate" src={`/media/team/linkedin/${person.image}-hover${person.image==='david'?'-reference':person.image==='kike'?'-closed-eyes':person.image==='iria'?'-facepalm-lowered':['paula','bobby'].includes(person.image)?'-v2':''}.${['david','iria'].includes(person.image)?'png':'webp'}`} alt="" aria-hidden="true" width="600" height="800" loading="lazy" decoding="async"/></>}<span class="person-number mono">{['CEO','HACKER','INVESTIGADORA','CIENTÍFICA','REDES','BECARIO'][i]}</span></div>
<div class="person-title"><h3>{person.name}</h3><PersonSocials name={person.name} instagram={person.instagram} linkedin={person.linkedin}/></div>
<p class="person-line">{person.line}<br/><span>{person.aside}</span></p></article>)}</div>

<section class="supporting-cast" aria-labelledby="supporting-heading">
  <div class="supporting-heading-row"><h3 id="supporting-heading">Con la cuestionable ayuda de...</h3>
  <button class="supporting-pause mono" aria-pressed="false">Pausar carrusel</button></div>
  <div class="supporting-viewport" tabindex="0" aria-label="Personajes secundarios"><div class="supporting-track">
  {[false,true].map(duplicate => <div class="supporting-grid" aria-hidden={duplicate ? "true" : undefined}>
    {supportingCast.map(person => <article class="supporting-person">
      <div class="person-photo">
        {person.image && <img src={person.image} alt={person.name} width="600" height="800" loading="lazy"/>}
        {person.name==='Bobby 2.0' && <img class="person-photo-alternate" src="/media/team/linkedin/bobby-hover-v2.webp" alt="" aria-hidden="true" width="600" height="800" loading="lazy"/>}
      </div>
      <div class="supporting-tag mono"><div><strong>{person.name}</strong><span>{person.role}</span></div>{(person.instagram != null || person.linkedin != null) && <div class="supporting-socials"><PersonSocials name={person.name} instagram={person.instagram} linkedin={person.linkedin} tabIndex={duplicate ? -1 : undefined}/></div>}</div>
    </article>)}
  </div>)}
  </div></div>
</section>
</section>
<section class="episode-section section-wrap" id="episodio"><span class="section-mark mark-crosshair" aria-hidden="true"></span><div class="section-label"><span>03 — DE LA TEORÍA A LA COMEDIA</span><span><i class="dot"></i> EPISODIO DISPONIBLE</span></div><div class="episode-grid"><div><p class="mono">CUÁNTICA SL / LA WEBSERIE</p><h2>La teoría<br/>es brillante.<br/><span class="serif-word">Mira la práctica.</span></h2><p class="episode-description">Una empresa de aparatos científicos imposibles.<br/>Un equipo que viene a trabajar y acaba haciendo historia.<br/>¿Qué podría salir bien?</p><button class="button" data-play>Ver el episodio completo <span aria-hidden="true">▶</span></button><p class="mono episode-duration">06:08 MIN · COMEDIA · EN ESPAÑOL</p></div><button class="episode-preview" data-play aria-label="Reproducir el episodio de Cuántica SL"><img src={site.poster} width="960" height="540" alt="David en la oficina, en una escena del episodio" loading="lazy"/><span class="play-circle" aria-hidden="true">▶</span><span class="preview-label mono">MENOS POWERPOINT. MÁS PLAY. <span>↗</span></span></button></div></section>
</main>
<footer class="footer"><div><Brand/><p>Sociedad limitada.<br/>Imaginación ilimitada.</p></div><a href="#inicio">Volver al principio <span aria-hidden="true">↑</span></a><div class="footer-bottom mono"><span>© 2026 CUÁNTICA SL — UNA EMPRESA DE FICCIÓN. POR SUERTE.</span><button id="motion-toggle" aria-pressed="false">Reducir movimiento</button></div></footer>
<dialog id="episode-dialog" aria-labelledby="player-title"><div class="player-heading"><div class="player-title-group"><h2 id="player-title">Cuántica S.L</h2><p class="player-episode-meta">Temporada 1, Episodio 1</p></div><button id="close-player" aria-label="Cerrar reproductor">Cerrar ×</button></div><video id="episode-player" controls playsinline preload="none" poster={site.poster} data-src={site.episode}></video><p id="player-error" hidden>No se ha podido reproducir. <a href={site.episode} download>Descargar el episodio</a>.</p></dialog>
<script>import { initExperience } from '../lib/experience'; initExperience();
const pause = document.querySelector<HTMLButtonElement>('.supporting-pause');
pause?.addEventListener('click', () => {
 const paused = pause.getAttribute('aria-pressed') !== 'true';
 pause.setAttribute('aria-pressed', String(paused));
 pause.textContent = paused ? 'Reanudar carrusel' : 'Pausar carrusel';
 document.querySelector('.supporting-cast')?.classList.toggle('is-paused', paused);
});
</script>
</body></html>
