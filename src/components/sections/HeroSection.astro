---
import Brand from '../Brand.astro';
import { site } from '../../content/site';
import { heroMotion } from '../../content/hero';
import forwardVideo from '../../assets/hero/hero-forward-optimized.mp4?url';
import forwardMobileVideo from '../../assets/hero/hero-forward-mobile.mp4?url';
import reverseMobileVideo from '../../assets/hero/hero-reverse-mobile.mp4?url';
import reverseVideo from '../../assets/hero/hero-reverse-optimized.mp4?url';
---
<section class="celestial film-scroll" id="inicio" aria-label="El universo de Cuántica SL" data-start-frame={heroMotion.startFrame} data-release-frame={heroMotion.releaseFrame} data-end-frame={heroMotion.endFrame} data-fps={heroMotion.fps}>
<span id="vision" class="vision-anchor" aria-hidden="true"></span>
<div class="film-stage cosmic-stage">
<img class="film-poster" src={site.hero} width="1920" height="1080" alt="David, CEO de Cuántica SL, asciende rodeado de los inventos de la empresa en un universo azul" fetchpriority="high"/>
<video id="hero-motion" class="hero-video" data-src={forwardVideo} data-src-mobile={forwardMobileVideo} muted playsinline preload="auto" disablepictureinpicture aria-hidden="true" tabindex="-1"></video>
<video id="hero-reverse" class="hero-video" data-src={reverseVideo} data-src-mobile={reverseMobileVideo} muted playsinline preload="auto" disablepictureinpicture aria-hidden="true" tabindex="-1"></video>
<header class="header cosmic-header"><Brand/></header>
<h1 class="cosmic-statement">{[
  { side: 'left', first: 'Inventamos', second: 'el futuro' },
  { side: 'right', first: 'Perdonad', second: 'las molestias' },
].map(statement => <span class={`statement-${statement.side}`}>
  {[true, false].map(shadow => <span class={shadow ? 'statement-shadow' : 'statement-face'} aria-hidden={shadow ? 'true' : undefined}>{statement.first}<br/>{' '}{statement.second}</span>)}
</span>)}</h1>
</div>
</section>
