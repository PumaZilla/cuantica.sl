---
import Brand from '../Brand.astro';
import { site } from '../../content/site';
import { heroMotion } from '../../content/hero';
import forwardVideo from '../../assets/hero/hero-forward-optimized.mp4?url';
import reverseVideo from '../../assets/hero/hero-reverse-optimized.mp4?url';
---
<section class="celestial film-scroll" id="inicio" aria-label="El universo de Cuántica SL" data-start-frame={heroMotion.startFrame} data-release-frame={heroMotion.releaseFrame} data-end-frame={heroMotion.endFrame} data-fps={heroMotion.fps}>
<span id="vision" class="vision-anchor" aria-hidden="true"></span>
<div class="film-stage cosmic-stage">
<img class="film-poster" src={site.hero} width="1920" height="1080" alt="David, CEO de Cuántica SL, asciende rodeado de los inventos de la empresa en un universo azul" fetchpriority="high"/>
<video id="hero-motion" class="hero-video" data-src={forwardVideo} muted playsinline preload="auto" disablepictureinpicture aria-hidden="true" tabindex="-1"></video>
<video id="hero-reverse" class="hero-video" data-src={reverseVideo} muted playsinline preload="auto" disablepictureinpicture aria-hidden="true" tabindex="-1"></video>
<header class="header cosmic-header"><Brand/></header>
<h1 class="cosmic-statement">{[
  { side: 'left', first: 'Inventamos', second: 'el futuro' },
  { side: 'right', first: 'Perdonad', second: 'las molestias' },
].map(statement => <span class={`statement-${statement.side}`}>
  {[true, false].map(shadow => <span class={shadow ? 'statement-shadow' : 'statement-face'} aria-hidden={shadow ? 'true' : undefined}>{statement.side === 'right' && <span class="statement-parenthesis parenthesis-open">(</span>}<span class="statement-first">{statement.first}</span><br/>{' '}<span class="statement-second">{statement.second}</span>{statement.side === 'right' && <span class="statement-parenthesis parenthesis-close">)</span>}</span>)}
</span>)}</h1>
<a href="#inventos" class="hero-scroll-hint" aria-label="Desplázate hacia abajo"><span class="hint-text">Desplázate</span><svg class="hint-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v11M3.5 8.5L8 13l4.5-4.5"/></svg></a>
</div>
</section>
