---
import Brand from '../Brand.astro';
import fecytLogo from '../../assets/brand/logo-ministerio-ciencia-fecyt.png?url';
import ceoAbertoLogo from '../../assets/brand/logo-ceo-aberto.png?url';
---
<footer class="footer">
  <div>
    <Brand />
    <p>Sociedad limitada.<br />Imaginación ilimitada.</p>
  </div>
  <div class="footer-collab">
    <span class="footer-collab-label mono">Con la colaboración de</span>
    <div class="footer-collab-logos">
      <div class="footer-logo-badge">
        <img src={fecytLogo} alt="Gobierno de España - Ministerio de Ciencia e Innovación - FECYT" class="footer-logo-fecyt" width="105" height="38" loading="lazy" />
      </div>
      <div class="footer-logo-badge">
        <img src={ceoAbertoLogo} alt="Ceo Aberto" class="footer-logo-ceo" width="38" height="38" loading="lazy" />
      </div>
    </div>
  </div>
  <div class="footer-bottom mono">
    <span>© 2026 CUÁNTICA SL — UNA EMPRESA DE FICCIÓN. POR SUERTE.</span>
    <a href="#inicio" class="footer-back-top">Volver al principio <span aria-hidden="true">↑</span></a>
  </div>
</footer>
