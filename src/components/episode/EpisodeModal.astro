---
import { site } from '../../content/site';
---
<dialog id="episode-dialog" aria-labelledby="player-title"><div class="player-heading"><div class="player-title-group"><h2 id="player-title">Cuántica S.L</h2><p id="player-meta" class="player-episode-meta" data-episode-label={site.episodeLabel}>{site.episodeLabel}</p></div><button id="close-player" aria-label="Cerrar reproductor">Cerrar ×</button></div><video id="episode-player" controls playsinline preload="none" poster={site.poster} data-src={site.episode}></video><div id="quantum-notice" class="quantum-notice" hidden><div class="quantum-notice-inner"><div class="quantum-notice-symbol mono" aria-hidden="true">ψ</div><p class="quantum-notice-title">Has encontrado un video cuántico.</p><p class="quantum-notice-subtitle">Parece que no está disponible... o puede que sí.</p><button type="button" id="quantum-switch-episode" class="button button-small quantum-notice-cta">Ver el episodio disponible (Ep. 8) <span aria-hidden="true">▶</span></button></div></div><p id="player-error" hidden>No se ha podido reproducir. <a href={site.episode} download>Descargar el episodio</a>.</p></dialog>
