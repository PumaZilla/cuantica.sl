---
import { site } from '../../content/site';
---
<dialog id="episode-dialog" aria-labelledby="player-title"><div class="player-heading"><div class="player-title-group"><h2 id="player-title">Cuántica S.L</h2><p class="player-episode-meta">{site.episodeLabel}</p></div><button id="close-player" aria-label="Cerrar reproductor">Cerrar ×</button></div><video id="episode-player" controls playsinline preload="none" poster={site.poster} data-src={site.episode}></video><p id="player-error" hidden>No se ha podido reproducir. <a href={site.episode} download>Descargar el episodio</a>.</p></dialog>
