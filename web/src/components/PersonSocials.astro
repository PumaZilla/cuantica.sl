---
interface Props {
  name: string;
  tabIndex?: number;
  instagram?: string | null;
  linkedin?: string | null;
}
const { name, instagram, linkedin, tabIndex } = Astro.props;
---
<div class="person-socials" aria-label={`Redes de ${name}`}>
  {[{ label: 'Instagram', url: instagram }, { label: 'LinkedIn', url: linkedin }].filter(({ url }) => url != null).map(({ label, url }) => {
    const Tag = url ? 'a' : 'button';
    return <Tag class="person-social" tabindex={tabIndex} href={url} target={url ? '_blank' : undefined} rel={url ? 'noopener noreferrer' : undefined} type={url ? undefined : 'button'} disabled={!url} aria-label={`${label} de ${name}${url ? '' : ' (próximamente)'}`} title={url ? label : `${label} · Próximamente`}>
      {label === 'Instagram' ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg> : <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM3.3 9h3.4v12H3.3zm5.7 0h3.3v1.6c.7-1.2 1.8-1.9 3.5-1.9 3.6 0 4.2 2.3 4.2 5.3v7h-3.4v-6.2c0-1.5 0-3.3-2-3.3s-2.2 1.6-2.2 3.2V21H9z"/></svg>}
    </Tag>;
  })}
</div>
